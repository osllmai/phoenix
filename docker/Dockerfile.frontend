# Frontend image (Next.js, multi-stage). Local dev uses node:22 + pnpm dev instead.
FROM node:22-slim AS build
WORKDIR /app
ENV COREPACK_INTEGRITY_KEYS=0
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM node:22-slim AS run
WORKDIR /app
ENV COREPACK_INTEGRITY_KEYS=0
RUN corepack enable
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["pnpm", "start"]
