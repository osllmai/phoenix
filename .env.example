# Phoenix monorepo env (backend + frontend together, like health). Copy to .env.
DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=*
# Postgres for docker/cloud. Comment out to fall back to local SQLite.
DATABASE_URL=postgres://phoenix:phoenix@postgres:5432/phoenix
# Postgres container credentials (must match DATABASE_URL above).
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=phoenix
POSTGRES_DB=phoenix
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Frontend (web) ---
# On-device gateway (phoenix_server) the browser calls. Exposed to the client,
# so it MUST be NEXT_PUBLIC_*. Points at the local gateway by default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:24678
# Renders the per-page mock state-switcher chips for design review. Leave unset
# (or 0) everywhere users can reach — it is a mock affordance, not a feature.
NEXT_PUBLIC_MOCK_STATES=0

# Mobile: override the on-device engine binary location for dev.
PHOENIX_ENGINE_DIR=engine/local_provider

# --- On-device gateway (packages/phoenix_server · OpenAI + Anthropic wire APIs) ---
# REQUIRED: bin/server.dart exits 64 without it. No built-in default by design.
PHOENIX_GATEWAY_PORT=24678
# Optional shared key. UNSET = open to every local process (loopback bind and
# loopback-only CORS stop browsers, not other programs on this machine).
# Set it and clients must send `Authorization: Bearer <key>` or `x-api-key: <key>`.
# PHOENIX_GATEWAY_API_KEY=

# --- Dev host ports (docker/local/compose.yml · `make up`) ---
# Phoenix = registry band 37000 (.claude/rules/ports.md): API +00 / Web +01 / PG +10 / Redis +20.
# HOST ports only; container-internal ports are unchanged (see URLs above).
API_PORT=37000
WEB_PORT=37001
PG_PORT=37010
REDIS_PORT=37020

# --- Production (docker/production/compose.yml + nginx.yml · `make up-prod`) ---
# Host port nginx publishes — HTTP/nginx offset +02 in the 37000 band.
HTTP_PORT=37002
# DEBUG is off in prod — these MUST be set to your real host/origin.
# ALLOWED_HOSTS=your.domain
# CSRF_TRUSTED_ORIGINS=https://your.domain

# --- Observability (docker/local/compose.yml) — band 37000 offsets +60/+61/+62/+72 ---
# Observability on/off. Empty = disabled. Set to 'observability' to enable
# grafana + prometheus + victorialogs + celery-exporter.
COMPOSE_PROFILES=
PROMETHEUS_PORT=37060
VICTORIALOGS_PORT=37061
GRAFANA_PORT=37062
CELERY_EXPORTER_PORT=37072
GRAFANA_ADMIN_PASSWORD=change-me

# --- required by Django with no default (a fresh `cp .env.example .env` needs these) ---
SESSION_COOKIE_AGE_SECONDS=1209600
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@phoenix.local
HEADLESS_URL_CONFIRM_EMAIL=http://localhost:37001/auth/confirm-email/{key}
HEADLESS_URL_RESET_PASSWORD=http://localhost:37001/auth/reset-password/{key}
HEADLESS_URL_SIGNUP=http://localhost:37001/auth/signup
TIME_ZONE=UTC
DOCUMENTS_ROOT=/app/documents
# Production only — explicit hosts, wildcard is refused at boot.
PROD_ALLOWED_HOSTS=your.domain.example
